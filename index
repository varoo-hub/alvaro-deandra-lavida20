<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Metro Dash 3D</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{margin:0;height:100%;overflow:hidden;background:#12082b;font-family:"Trebuchet MS","Segoe UI",system-ui,sans-serif;color:#fff;touch-action:none}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
#flash{position:fixed;inset:0;background:#ff2d55;opacity:0;pointer-events:none;transition:opacity .5s}
#hud{position:fixed;top:0;left:0;right:0;padding:calc(env(safe-area-inset-top,0px) + 10px) 12px 0;display:none;gap:8px;align-items:flex-start;flex-wrap:wrap;pointer-events:none}
.box{background:rgba(20,8,50,.65);border:2px solid #ffffff33;border-radius:14px;padding:6px 12px;font-size:15px;pointer-events:none}
.box b{font-size:20px;color:#ffd23f;margin-left:4px}
.btns{margin-left:auto;display:flex;gap:6px;pointer-events:auto}
button{font:inherit;font-weight:800;color:#fff;border:0;cursor:pointer}
.sm{background:rgba(20,8,50,.75);border:2px solid #ffffff44;border-radius:12px;padding:8px 11px;font-size:13px}
.sm:active{transform:scale(.94)}
.ov{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:20px;background:radial-gradient(ellipse at center,rgba(40,10,90,.55),rgba(10,4,30,.88))}
.ov.on{display:flex}
h1{margin:0;font-size:clamp(38px,9vw,78px);line-height:.95;font-weight:900;letter-spacing:-1px;color:#ffd23f;text-shadow:0 4px 0 #ff3d71,0 8px 0 #7a1fff,0 14px 24px #0008;transform:rotate(-3deg)}
h2{margin:0;font-size:clamp(34px,8vw,60px);font-weight:900;color:#ff5c8a;text-shadow:0 4px 0 #3b0a6e}
p{margin:0;max-width:420px;line-height:1.5;color:#e9ddff}
.go{background:linear-gradient(#3ddc84,#16a34a);border-radius:18px;padding:14px 44px;font-size:24px;box-shadow:0 6px 0 #0b6b2e,0 12px 20px #0006;margin-top:6px}
.go:active{transform:translateY(4px);box-shadow:0 2px 0 #0b6b2e}
.go.alt{background:linear-gradient(#ff7a45,#e11d48);box-shadow:0 6px 0 #8f0f2c,0 12px 20px #0006}
.stat{font-size:22px}.stat b{color:#ffd23f}
kbd{background:#ffffff22;border-radius:6px;padding:1px 7px;font-family:inherit;font-weight:700}
#pad{position:fixed;left:0;right:0;bottom:0;padding:0 14px calc(env(safe-area-inset-bottom,0px) + 16px);display:none;justify-content:space-between;pointer-events:none}
#pad div{display:flex;gap:12px;pointer-events:auto;align-items:flex-end}
#pad button{width:68px;height:68px;border-radius:50%;background:rgba(255,255,255,.2);border:3px solid #ffffff77;font-size:28px;backdrop-filter:blur(3px)}
#pad button:active{background:rgba(255,210,63,.6)}
#pad .col{flex-direction:column}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="flash"></div>

<div id="hud">
  <div class="box">Skor <b id="sc">0</b></div>
  <div class="box">🪙<b id="cn">0</b></div>
  <div class="box">⚡<b id="sp">1.0x</b></div>
  <div class="btns">
    <button class="sm" id="bm">🔊</button>
    <button class="sm" id="bp">⏸ PAUSE</button>
    <button class="sm" id="br">↻ RESTART</button>
  </div>
</div>

<div id="pad">
  <div><button id="tl">◀</button><button id="tr">▶</button></div>
  <div><button id="tu">▲</button><button id="td">▼</button></div>
</div>

<div class="ov on" id="menu">
  <h1>METRO<br>DASH 3D</h1>
  <p>Lari di terowongan kereta bawah tanah, hindari kereta dan rintangan, kumpulkan koin sebanyak mungkin.</p>
  <p><kbd>←</kbd> <kbd>→</kbd> pindah jalur &nbsp; <kbd>↑</kbd>/<kbd>Spasi</kbd> lompat &nbsp; <kbd>↓</kbd> slide &nbsp; <kbd>P</kbd> pause<br>Di HP: geser layar atau pakai tombol.</p>
  <div class="stat">Rekor <b id="hi0">0</b></div>
  <button class="go" id="bs">START</button>
</div>

<div class="ov" id="pause">
  <h2>PAUSE</h2>
  <button class="go" id="bc">LANJUT</button>
  <button class="go alt" id="br2">RESTART</button>
</div>

<div class="ov" id="over">
  <h2>GAME OVER</h2>
  <div class="stat">Skor <b id="fs">0</b></div>
  <div class="stat">Koin <b id="fc">0</b></div>
  <div class="stat">Rekor <b id="fh">0</b></div>
  <button class="go alt" id="br3">RESTART</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
const $=id=>document.getElementById(id);
const LW=2.6, LANES=[-LW,0,LW];

/* ---------- Audio ---------- */
let AC=null, muted=false;
function snd(f,d,type,v,f2){
  if(!AC||muted)return;
  const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();
  o.type=type||'square';o.frequency.setValueAtTime(f,t);
  if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);
  g.gain.setValueAtTime(v||.1,t);g.gain.exponentialRampToValueAtTime(.001,t+d);
  o.connect(g);g.connect(AC.destination);o.start(t);o.stop(t+d);
}
const sCoin=()=>{snd(988,.07,'square',.08);setTimeout(()=>snd(1319,.12,'square',.08),60)};
const sJump=()=>snd(280,.22,'sine',.2,720);
const sSlide=()=>snd(500,.25,'sawtooth',.05,90);
const sMove=()=>snd(220,.06,'triangle',.12,140);
const sCrash=()=>{snd(160,.6,'sawtooth',.25,25);snd(90,.5,'square',.15,20)};

/* ---------- Three.js dasar ---------- */
const renderer=new THREE.WebGLRenderer({canvas:$('c'),antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio||1,2));
const scene=new THREE.Scene();
const SKY=0x7fd0ff;
scene.background=new THREE.Color(SKY);
scene.fog=new THREE.Fog(SKY,35,135);
const cam=new THREE.PerspectiveCamera(65,1,.1,220);
function resize(){
  const w=innerWidth,h=innerHeight;renderer.setSize(w,h,false);
  cam.aspect=w/h;cam.fov=w/h<.8?88:65;cam.updateProjectionMatrix();
}
addEventListener('resize',resize);resize();
scene.add(new THREE.HemisphereLight(0xffffff,0x5a4a9a,.95));
const sun=new THREE.DirectionalLight(0xfff0c8,.8);sun.position.set(-8,20,12);scene.add(sun);

const mc={},gc={};
const mat=c=>mc[c]||(mc[c]=new THREE.MeshLambertMaterial({color:c}));
const geo=(w,h,d)=>{const k=w+','+h+','+d;return gc[k]||(gc[k]=new THREE.BoxGeometry(w,h,d))};
function bx(w,h,d,c,x,y,z){const m=new THREE.Mesh(geo(w,h,d),mat(c));m.position.set(x||0,y||0,z||0);return m}

/* ---------- Dunia: jalur, rel, bantalan, gedung ---------- */
const TW=LW*3+1.2;
const ground=bx(TW,.2,260,0x3a3550,0,-.1,-90);scene.add(ground);
const side=bx(120,.2,260,0x2d8f6f,0,-.35,-90);scene.add(side);
LANES.forEach(x=>{
  scene.add(bx(.12,.1,260,0xc9c9d6,x-.55,.05,-90));
  scene.add(bx(.12,.1,260,0xc9c9d6,x+.55,.05,-90));
});
[-LW/2,LW/2].forEach(x=>scene.add(bx(.12,.02,260,0xffd23f,x,.01,-90)));
[-1,1].forEach(s=>{
  scene.add(bx(.5,1.2,260,0x7a1fff,s*(TW/2+.25),.5,-90));
  scene.add(bx(.55,.2,260,0xff3d71,s*(TW/2+.25),1.15,-90));
});

const movers=[]; // {m, len}
const TIES=40,TS=6;
for(let i=0;i<TIES;i++){
  const m=bx(TW-.4,.08,.35,0x8b5a2b,0,.04,-i*TS+8);scene.add(m);movers.push({m,len:TIES*TS});
}
const BN=30,BS=8,PAL=[0xff3d71,0xffd23f,0x3ddc84,0x4cc9f0,0xb15cff,0xff8a3d,0x2ee6c8];
for(let i=0;i<BN;i++)for(const s of[-1,1]){
  const h=5+Math.random()*13,w=4+Math.random()*3,c=PAL[(Math.random()*PAL.length)|0];
  const g=new THREE.Group();
  g.add(bx(w,h,6,c,0,h/2,0));
  g.add(bx(w+.3,.5,6.3,0x241040,0,h+.25,0));
  for(let k=0;k<Math.floor(h/3);k++)g.add(bx(w*.6,.9,.1,0xfff3b0,0,2.2+k*3,3.05));
  g.position.set(s*(TW/2+4.5+w/2+Math.random()*3),0,-i*BS+10);
  scene.add(g);movers.push({m:g,len:BN*BS});
}

/* ---------- Pemain ---------- */
const player=new THREE.Group();scene.add(player);
const pBody=bx(.8,.95,.5,0xff3d71,0,1.1,0);
const pPack=bx(.6,.7,.25,0xffd23f,0,1.15,.35);
const pHead=new THREE.Mesh(new THREE.SphereGeometry(.3,16,12),mat(0xffc9a0));pHead.position.set(0,1.85,0);
const pCap=bx(.65,.2,.65,0x4cc9f0,0,2.05,0);
const pBill=bx(.5,.07,.35,0x1d8fb5,0,1.98,-.4);
player.add(pBody,pPack,pHead,pCap,pBill);
function limb(w,h,c,x,y){const g=new THREE.Group();g.position.set(x,y,0);const m=bx(w,h,w,c,0,-h/2,0);g.add(m);player.add(g);return g}
const legL=limb(.28,.65,0x3a5bff,-.2,.65),legR=limb(.28,.65,0x3a5bff,.2,.65);
const armL=limb(.22,.6,0xff3d71,-.5,1.5),armR=limb(.22,.6,0xff3d71,.5,1.5);
const shadow=new THREE.Mesh(new THREE.CircleGeometry(.5,16),new THREE.MeshBasicMaterial({color:0,transparent:true,opacity:.3}));
shadow.rotation.x=-Math.PI/2;shadow.position.y=.02;scene.add(shadow);

/* ---------- State ---------- */
const G={s:'menu',speed:0,t:0,dist:0,coins:0,hi:0,lane:1,vy:0,py:0,slide:0,slideQ:false,gap:0,shake:0,phase:0};
try{G.hi=+localStorage.getItem('mdash3d_hi')||0}catch(e){}
$('hi0').textContent=G.hi;
const obs=[],coins=[];
const TRAIN=[0xe63946,0x2a9df4,0xffb703,0x9b5de5,0x06d6a0,0xff7b00];
const coinGeo=new THREE.CylinderGeometry(.38,.38,.1,18);coinGeo.rotateX(Math.PI/2);
const coinMat=new THREE.MeshLambertMaterial({color:0xffd23f,emissive:0x8a6500});

function addObs(m,x,z,hw,hd,y0,y1){m.position.x=x;m.position.z=z;scene.add(m);obs.push({m,x,hw,hd,y0,y1})}
function mkTrain(x,z){
  const g=new THREE.Group(),c=TRAIN[(Math.random()*TRAIN.length)|0];
  g.add(bx(2,3,9,c,0,1.8,0));
  g.add(bx(2.1,.25,9.1,0x222233,0,3.35,0));
  g.add(bx(2.04,.8,7,0x1b2a44,0,2.4,0));
  g.add(bx(1.5,1,.1,0xbfe8ff,0,2.3,4.52));
  g.add(bx(.35,.3,.1,0xfff176,-.6,.9,4.52),bx(.35,.3,.1,0xfff176,.6,.9,4.52));
  g.add(bx(2.1,.35,9.1,0x222233,0,.35,0));
  addObs(g,x,z,1.05,4.5,0,3.4);
}
function mkLow(x,z){
  const g=new THREE.Group();
  g.add(bx(2.2,.45,.5,0xff3d71,0,.65,0),bx(2.2,.35,.5,0xffffff,0,.25,0));
  g.add(bx(.2,.9,.3,0x333344,-.9,.45,0),bx(.2,.9,.3,0x333344,.9,.45,0));
  addObs(g,x,z,1.1,.3,0,.9);
}
function mkHigh(x,z){
  const g=new THREE.Group();
  g.add(bx(.25,2.2,.25,0x333344,-1.05,1.1,0),bx(.25,2.2,.25,0x333344,1.05,1.1,0));
  g.add(bx(2.3,.7,.35,0xffd23f,0,1.65,0),bx(2.3,.15,.37,0x222233,0,1.35,0));
  addObs(g,x,z,1.15,.3,1.3,2.1);
}
function mkCoin(x,y,z){const m=new THREE.Mesh(coinGeo,coinMat);m.position.set(x,y,z);scene.add(m);coins.push({m,x,y})}

function spawnRow(z){
  const t=[0,0,0],r=Math.random();
  const lanes=[0,1,2].sort(()=>Math.random()-.5);
  const fill=(n,v)=>{for(let i=0;i<n;i++)t[lanes[i]]=v};
  if(r<.32)fill(1+(Math.random()<.5?1:0),1);
  else if(r<.55)fill(1+((Math.random()*3)|0),2);
  else if(r<.72)fill(1+((Math.random()*3)|0),3);
  else if(r<.86){t[lanes[0]]=1;t[lanes[1]]=2+(Math.random()<.5?1:0);t[lanes[2]]=Math.random()<.5?3:0}
  const free=[];
  for(let i=0;i<3;i++){
    const x=LANES[i];
    if(t[i]===1)mkTrain(x,z);
    else if(t[i]===2){mkLow(x,z);if(Math.random()<.6)for(let k=0;k<5;k++){const u=(k-2)/2;mkCoin(x,1.2+(1-u*u)*1.1,z+(k-2)*1.5)}}
    else if(t[i]===3)mkHigh(x,z);
    else free.push(i);
  }
  if(free.length&&Math.random()<.75){const x=LANES[free[(Math.random()*free.length)|0]];for(let k=0;k<5;k++)mkCoin(x,1,z+(k-2)*2.2)}
}

function clearWorld(){
  obs.forEach(o=>scene.remove(o.m));coins.forEach(c=>scene.remove(c.m));obs.length=0;coins.length=0;
}
function reset(){
  clearWorld();
  Object.assign(G,{speed:15,t:0,dist:0,coins:0,lane:1,vy:0,py:0,slide:0,slideQ:false,gap:0,shake:0});
  player.position.set(0,0,0);player.rotation.x=0;
  cam.position.set(0,4.6,7.5);
  spawnRow(-80);spawnRow(-112);spawnRow(-144);G.gap=24;
  hud();
}

/* ---------- Kontrol ---------- */
function act(a){
  if(G.s!=='play')return;
  if(a==='L'&&G.lane>0){G.lane--;sMove()}
  else if(a==='R'&&G.lane<2){G.lane++;sMove()}
  else if(a==='U'&&G.py<.05){G.vy=11.5;G.py=.01;G.slide=0;sJump()}
  else if(a==='D'){
    if(G.py>.05){G.vy=-20;G.slideQ=true}
    else{G.slide=.8;sSlide()}
  }
}
addEventListener('keydown',e=>{
  const k=e.key;
  if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(k))e.preventDefault();
  if(k==='ArrowLeft'||k==='a'||k==='A')act('L');
  else if(k==='ArrowRight'||k==='d'||k==='D')act('R');
  else if(k==='ArrowUp'||k==='w'||k==='W'||k===' ')act('U');
  else if(k==='ArrowDown'||k==='s'||k==='S')act('D');
  else if(k==='p'||k==='P'||k==='Escape')togglePause();
  else if(k==='Enter'){if(G.s==='menu'||G.s==='over')start();else if(G.s==='pause')togglePause()}
});
let tx=0,ty=0,tOn=false;
const cv=$('c');
cv.addEventListener('touchstart',e=>{const t=e.touches[0];tx=t.clientX;ty=t.clientY;tOn=true;e.preventDefault()},{passive:false});
cv.addEventListener('touchmove',e=>{
  if(!tOn)return;const t=e.touches[0],dx=t.clientX-tx,dy=t.clientY-ty;
  if(Math.max(Math.abs(dx),Math.abs(dy))>32){
    if(Math.abs(dx)>Math.abs(dy))act(dx>0?'R':'L');else act(dy>0?'D':'U');
    tOn=false;
  }
  e.preventDefault();
},{passive:false});
cv.addEventListener('touchend',()=>{tOn=false});
function bind(id,fn){
  const b=$(id);
  b.addEventListener('pointerdown',e=>{e.preventDefault();fn()});
}
bind('tl',()=>act('L'));bind('tr',()=>act('R'));bind('tu',()=>act('U'));bind('td',()=>act('D'));
if('ontouchstart' in window||navigator.maxTouchPoints>0)$('pad').style.display='flex';

function click(id,fn){$(id).addEventListener('click',fn)}
click('bs',start);click('br',start);click('br2',start);click('br3',start);click('bc',togglePause);click('bp',togglePause);
click('bm',()=>{muted=!muted;$('bm').textContent=muted?'🔇':'🔊'});

function show(id,on){$(id).classList.toggle('on',on)}
function start(){
  if(!AC){try{AC=new(window.AudioContext||window.webkitAudioContext)()}catch(e){}}
  if(AC&&AC.state==='suspended')AC.resume();
  reset();G.s='play';
  show('menu',false);show('over',false);show('pause',false);
  $('hud').style.display='flex';$('bp').textContent='⏸ PAUSE';
  $('flash').style.opacity=0;
}
function togglePause(){
  if(G.s==='play'){G.s='pause';show('pause',true);$('bp').textContent='▶ LANJUT'}
  else if(G.s==='pause'){G.s='play';show('pause',false);$('bp').textContent='⏸ PAUSE'}
}
function gameOver(){
  G.s='over';sCrash();G.shake=.6;
  const f=$('flash');f.style.transition='none';f.style.opacity=.55;
  requestAnimationFrame(()=>{f.style.transition='opacity .6s';f.style.opacity=0});
  const sc=score();
  if(sc>G.hi){G.hi=sc;try{localStorage.setItem('mdash3d_hi',sc)}catch(e){}}
  $('fs').textContent=sc;$('fc').textContent=G.coins;$('fh').textContent=G.hi;$('hi0').textContent=G.hi;
  setTimeout(()=>{if(G.s==='over')show('over',true)},700);
}
const score=()=>Math.floor(G.dist)+G.coins*10;
function hud(){$('sc').textContent=score();$('cn').textContent=G.coins;$('sp').textContent=(G.speed/15).toFixed(1)+'x'}

/* ---------- Update ---------- */
function moveWorld(d){
  for(const o of movers){o.m.position.z+=d;if(o.m.position.z>12)o.m.position.z-=o.len}
}
function animateRunner(dt,running){
  G.phase+=dt*(9+G.speed*.35);
  const air=G.py>.05,s=Math.sin(G.phase);
  if(air){legL.rotation.x=-.8;legR.rotation.x=.5;armL.rotation.x=-2.2;armR.rotation.x=-2.2}
  else if(running){legL.rotation.x=s*.9;legR.rotation.x=-s*.9;armL.rotation.x=-s*.8;armR.rotation.x=s*.8}
  pBody.rotation.z=Math.sin(G.phase*.5)*.04;
}
function update(dt){
  G.t+=dt;
  G.speed=Math.min(15+G.t*.45,40);
  const d=G.speed*dt;G.dist+=d*.5;G.gap+=d;
  moveWorld(d);
  // jalur
  const tx2=LANES[G.lane];
  player.position.x+=(tx2-player.position.x)*Math.min(1,16*dt);
  // fisika
  if(G.py>0||G.vy>0){
    G.vy-=34*dt;G.py+=G.vy*dt;
    if(G.py<=0){G.py=0;G.vy=0;if(G.slideQ){G.slideQ=false;G.slide=.8;sSlide()}}
  }
  if(G.slide>0)G.slide-=dt;
  const sliding=G.slide>0&&G.py<.05;
  const ph=sliding?.9:1.8;
  player.rotation.x+=((sliding?-1.2:0)-player.rotation.x)*Math.min(1,18*dt);
  player.position.y=G.py+(sliding?.3:0);
  shadow.position.set(player.position.x,.03,0);
  shadow.scale.setScalar(Math.max(.4,1-G.py*.25));
  animateRunner(dt,true);
  // spawn
  if(G.gap>=26+G.speed*.4){G.gap=0;spawnRow(-148)}
  // rintangan
  const px=player.position.x;
  for(let i=obs.length-1;i>=0;i--){
    const o=obs[i];o.m.position.z+=d;const z=o.m.position.z;
    if(z>14){scene.remove(o.m);obs.splice(i,1);continue}
    if(Math.abs(px-o.x)<o.hw+.35&&Math.abs(z)<o.hd+.3&&G.py<o.y1&&G.py+ph>o.y0+(o.y0===0?0:.05)){
      if(o.y0===0&&o.y1<1&&G.py>=o.y1-.15)continue;
      gameOver();return;
    }
  }
  // koin
  for(let i=coins.length-1;i>=0;i--){
    const c=coins[i];c.m.position.z+=d;c.m.rotation.y+=dt*5;const z=c.m.position.z;
    if(z>14){scene.remove(c.m);coins.splice(i,1);continue}
    if(Math.abs(px-c.x)<.9&&Math.abs(z)<1&&c.y+.4>G.py&&c.y-.4<G.py+ph){
      scene.remove(c.m);coins.splice(i,1);G.coins++;sCoin();
    }
  }
  hud();
}

/* ---------- Loop ---------- */
let last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min((now-last)/1000,.05);last=now;
  if(G.s==='play')update(dt);
  else if(G.s==='menu'){G.speed=9;moveWorld(9*dt);animateRunner(dt,true);player.position.y=0;
    cam.position.set(Math.sin(now/1800)*2,3.2,6.2);cam.lookAt(0,1.4,0);renderer.render(scene,cam);return}
  else if(G.s==='over'){G.shake*=.9}
  // coin spin saat pause tidak perlu
  const px=player.position.x;
  cam.position.x+=(px*.55-cam.position.x)*Math.min(1,6*dt);
  const sh=G.shake>.01?(Math.random()-.5)*G.shake:0;
  cam.position.y=4.6+G.py*.25+sh;cam.position.z=7.5;
  cam.lookAt(px*.35,1.3,-12);
  renderer.render(scene,cam);
}
reset();G.s='menu';
requestAnimationFrame(loop);
})();
</script>
